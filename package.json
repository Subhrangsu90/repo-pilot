{
  "name": "repopilot",
  "version": "0.0.0",
  "private": true,
  "packageManager": "npm@11.6.4",
  "workspaces": [
    "projects/*"
  ],
  "scripts": {
    "dev:web": "npm run start -w @repopilot/web",
    "dev:server": "npm run dev -w @repopilot/server",
    "db:up": "docker compose up -d --wait db",
    "db:down": "docker compose stop db",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "format": "prettier --write \"projects/**/*.{ts,html,css,json}\"",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2"
  }
}
