{
  "name": "@repopilot/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "RepoPilot agent server: model loop, GitHub tools, approval gate, AG-UI event stream.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "check": "tsx src/check-env.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@repopilot/shared": "*",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.6.0",
    "postgres": "^4.1.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.20.0",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  }
}
