# Copy to projects/server/.env (git-ignored), fill in, then verify with:
#   npm run check -w @repopilot/server

PORT=3000

# Which model answers: gemini | claude | ollama
LLM_PROVIDER=gemini

# Gemini Flash (free tier) – key from https://aistudio.google.com/apikey
# Note: free-tier prompts may be used by Google to improve its products; use the
# demo repo only, or switch to ollama for the privacy story.
GEMINI_API_KEY=
# Run `npm run check -w @repopilot/server` to test the key and model.
# The newest models are often overloaded on the free tier; the fallback is used on 503/timeout.
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash

# Claude Haiku (optional, paid) – key from https://console.anthropic.com
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5

# Gemma via Ollama (local, free, private) – install Ollama, then: ollama pull gemma4
OLLAMA_URL=http://localhost:11434
# gemma4:e2b needs ~7 GB of free RAM; llama3.2 (~2 GB) works on tighter machines.
OLLAMA_MODEL=gemma4
# Context window. Lower it (e.g. 4096) if Ollama reports it cannot allocate memory.
OLLAMA_NUM_CTX=8192

# Dev mode only (no GitHub sign-in configured below): a fine-grained personal access token. The app lists
# the repositories it can see and works on the one picked in the side nav.
# Permissions: Contents, Issues, Pull requests, Actions = read; Issues, Pull requests, Contents = write.
GITHUB_TOKEN=

# Postgres for sessions, runs and the audit log (npm run db:up starts it in Docker).
# Leave empty to run without a database: everything stays in memory and History / Audit log are off.
DATABASE_URL=postgres://repopilot:repopilot@127.0.0.1:5433/repopilot

# Sign in with GitHub (OAuth App: github.com → Settings → Developer settings → OAuth Apps → New).
# Homepage URL = APP_URL; Authorization callback URL = APP_URL/api/auth/callback.
# All three set → each user signs in and acts with their own GitHub account (token kept in a sealed,
# httpOnly cookie). Left empty → dev mode: everyone acts as the owner of GITHUB_TOKEN.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# At least 32 random characters, e.g. node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=
# repo: public and private repositories (GitHub OAuth Apps cannot narrow this per repository; every change
# still needs your approval). public_repo: public repositories only.
GITHUB_OAUTH_SCOPE=repo
# Where the browser opens the app (dev: the Angular dev server, which proxies /api).
APP_URL=http://localhost:4200
