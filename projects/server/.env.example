# Copy to projects/server/.env (git-ignored). Nothing here is needed until week 2.

PORT=3000

# Which model answers: gemini | claude | ollama
LLM_PROVIDER=gemini

# Gemini Flash (free tier) – key from https://aistudio.google.com/apikey
# Note: free-tier prompts may be used by Google to improve its products; use the
# demo repo only, or switch to ollama for the privacy story.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Claude Haiku (optional, paid) – key from https://console.anthropic.com
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5

# Gemma via Ollama (local, free, private) – install Ollama, then: ollama pull gemma3
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma3

# GitHub fine-grained personal access token, limited to the demo repo.
# Permissions: Contents, Issues, Pull requests, Actions = read (write added in week 3).
GITHUB_TOKEN=
# Comma-separated owner/repo list the agent may touch.
GITHUB_REPO_ALLOWLIST=
