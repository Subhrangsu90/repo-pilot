{
  "compilerOptions": {
    "target": "ES2023",
    "module": "preserve",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noImplicitOverride": true,
    "types": ["node", "vitest/globals"]
  },
  "include": ["src/**/*.ts"]
}
