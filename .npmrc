# @a2ui/angular 0.14.0 (the latest) declares Angular ^21.2.5 as a peer, and the app runs
# Angular 22. npm's `overrides` cannot widen a peer range, so peer conflicts are not fatal
# here. The renderer is covered by the web tests on Angular 22. Remove this line once
# @a2ui/angular accepts Angular 22.
legacy-peer-deps=true
